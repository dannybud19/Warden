NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=0

# Voice onboarding ("Call Warden"), server-side only. Never prefix these with NEXT_PUBLIC_.
# 1) add your key, 2) run `node scripts/create-voice-agent.mjs` (it fills in the agent id), 3) restart dev.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
