# LLM. Default: Anthropic.
LLM_PROVIDER=anthropic      # anthropic | openai_compatible
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# To build on a free tier instead, set LLM_PROVIDER=openai_compatible and, for Gemini:
#   LLM_API_KEY=<key from Google AI Studio>
#   LLM_MODEL=gemini-3.8-flash
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   (the default)
#   LLM_REASONING_EFFORT=low                                               (optional, faster)
# Free tiers may use what you send to improve their products: synthetic cases only.
LLM_API_KEY=
LINKUP_API_KEY=
COMPANIES_HOUSE_API_KEY=
STORAGE=memory              # memory | mongo
MONGODB_URI=
MONGODB_DB=rss
CORS_ORIGINS=http://localhost:3000
DEFAULT_AGENT_MODE=stub     # stub | real
# Per-agent override, e.g.:
# AGENT_MODE_MESSAGE_CHECKER=real
