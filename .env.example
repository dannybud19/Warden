# LLM. Default: Anthropic.
LLM_PROVIDER=anthropic      # anthropic | openai_compatible
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# To build on Gemini's free tier instead, set LLM_PROVIDER=openai_compatible and:
#   LLM_API_KEY=<your own key from Google AI Studio: one per person, never shared or committed>
#   LLM_MODEL=gemini-3.5-flash-lite      (fast; gemini-3.8-flash timed out on the free tier)
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   (the default)
#   LLM_REASONING_EFFORT=low                                               (optional, faster)
#   LLM_TIMEOUT_S=20                     (per attempt; one retry on a timeout)
# Free tiers may use what you send to improve their products: synthetic cases only.
LLM_API_KEY=
LINKUP_API_KEY=
COMPANIES_HOUSE_API_KEY=
STORAGE=memory              # memory | mongo
MONGODB_URI=
MONGODB_DB=rss
CORS_ORIGINS=http://localhost:3000
DEFAULT_AGENT_MODE=stub     # stub | real
# Per-agent override, e.g.:
# AGENT_MODE_MESSAGE_CHECKER=real
